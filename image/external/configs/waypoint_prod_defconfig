# Waypoint production defconfig (Pi 5, 4 GB).
#
# Generated by hand-layering Waypoint package selections over upstream
# raspberrypi5_defconfig. The exact option names may shift between
# Buildroot versions — re-run `make menuconfig` + `make savedefconfig`
# after pinning to a new Buildroot release.

# Architecture
BR2_aarch64=y
BR2_cortex_a76=y

# Toolchain — glibc gives us ucontext + atomics, both required by
# libabseil-cpp → protobuf → waypoint-core. glibc has a hard `depends on`
# kernel headers >= 3.2, and BR2_KERNEL_HEADERS_AS_KERNEL only propagates
# headers-at-least when LATEST_VERSION is selected, not via
# CUSTOM_VERSION_VALUE — so pick 6.6 explicitly to match the target.
BR2_KERNEL_HEADERS_6_6=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# Kernel — Pi Foundation's fork carries bcm2712_defconfig, VC4 GPU
# driver, camera firmware, and other Pi-specific bits that aren't fully
# upstream. The pinned SHA matches Buildroot 2026.02's raspberrypi5_defconfig.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,raspberrypi,linux,21b410140c47ffab5668399f6f143c7d7b935c8b)/linux-21b410140c47ffab5668399f6f143c7d7b935c8b.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcm2712"
# Pi 5 uses 4K pages, not the 16K ARM64 default.
# linux-virtio.fragment adds CONFIG_VIRTIO_{MMIO,BLK,NET,...} so the same
# kernel that ships to the Pi can also boot under qemu-system-aarch64 -M virt
# for the swupdate OTA smokes. Without it, the kernel can't see /dev/vda
# and hangs on rootwait.
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="board/raspberrypi/linux-4k-page-size.fragment $(BR2_EXTERNAL_WAYPOINT_PATH)/board/raspberrypi5/linux-virtio.fragment $(BR2_EXTERNAL_WAYPOINT_PATH)/board/raspberrypi5/linux-cameras.fragment $(BR2_EXTERNAL_WAYPOINT_PATH)/board/raspberrypi5/linux-servobus.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2712-rpi-5-b broadcom/bcm2712d0-rpi-5-b broadcom/bcm2712-rpi-500"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# System
BR2_INIT_SYSTEMD=y
BR2_PACKAGE_SYSTEMD_PORTABLED=y
BR2_TARGET_GENERIC_HOSTNAME="waypoint"
BR2_TARGET_GENERIC_ISSUE="Waypoint OS"
BR2_SYSTEM_BIN_SH_BASH=y
BR2_PACKAGE_BUSYBOX_INDIVIDUAL_BINARIES=y

# Filesystem
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS_XZ=y
# Do not produce a tarball or ext4 — squashfs only.
# BR2_TARGET_ROOTFS_TAR is not set
# BR2_TARGET_ROOTFS_EXT2 is not set

# Pi 5 firmware. No _VARIANT_ selected: Pi 5 boots from its SPI EEPROM
# bootloader, not from bootcode.bin/start.elf/fixup.dat on the SD card,
# so those files are intentionally absent. Pi-specific blobs come via
# the kernel package.
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_WAYPOINT_PATH)/board/raspberrypi5/config.txt"
# cmdline.txt.in is a template — post-image.sh substitutes the rootfs
# PARTUUID into BINARIES_DIR/rpi-firmware/cmdline.txt before genimage
# assembles the boot partition.
BR2_PACKAGE_RPI_FIRMWARE_CMDLINE_FILE="$(BR2_EXTERNAL_WAYPOINT_PATH)/board/raspberrypi5/cmdline.txt.in"
# Install the Pi 5 device-tree overlays. Necessary even though we don't
# use `dtoverlay=` lines directly — Pi 5 firmware leans on small overlay
# snippets to apply some `dtparam=` directives (e.g. dtparam=uart0=on
# silently fails without an accessible /boot/overlays/). Adds ~10 MB
# to the boot partition; acceptable.
BR2_PACKAGE_RPI_FIRMWARE_INSTALL_DTB_OVERLAYS=y

# Host-side image-assembly tools: genimage builds the .img from
# partitions, mkfs.vfat formats the boot partition, mcopy installs
# files into it, mke2fs creates the /data ext4 filesystem.
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_HOST_E2FSPROGS=y

# Waypoint. The dashboard is embedded into the agent binary at Go-compile
# time via //go:embed all:dist in agent/web/embed.go; image/Makefile's
# embed-dashboard target refreshes that source tree before each image
# build so the embed stays in sync with dashboard/.
BR2_PACKAGE_WAYPOINT_AGENT=y
BR2_PACKAGE_WAYPOINT_CORE=y
BR2_PACKAGE_WAYPOINT_BOOTCHECK=y
BR2_PACKAGE_WAYPOINT_FIRSTBOOT=y
BR2_PACKAGE_WAYPOINT_RESIZE=y
# Target-side filesystem-grow tools used by waypoint-resize at first boot
# to expand the trailing "store" partition to fill the card: sgdisk
# (gptfdisk) rewrites the GPT to fill free space, partx pokes the kernel
# to pick up the new size while mounted, resize2fs grows the ext4 online.
# (Buildroot 2026.02 has no growpart package, so the script drives sgdisk.)
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
BR2_PACKAGE_GPTFDISK=y
BR2_PACKAGE_GPTFDISK_SGDISK=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y
# Network
BR2_PACKAGE_OPENSSH=n
BR2_PACKAGE_DROPBEAR=n
BR2_PACKAGE_CONNMAN=y
# Required for the agent's Sigstore TUF fetch over HTTPS.
BR2_PACKAGE_CA_CERTIFICATES=y

# swupdate.
#
# Buildroot's default swupdate.config has CONFIG_CURL/CONFIG_DOWNLOAD off
# and CONFIG_WEBSERVER on, neither of which fits Waypoint:
#   - We need HTTP download support so the agent's apply handler (and the
#     QEMU OTA smoke) can fetch .swu artifacts at install time.
#   - We do NOT want the webserver on :8080 — it collides with the agent's
#     dashboard port and our OTA path is NATS rpc.apply_image, not the
#     swupdate webserver UI.
# We override BR2_PACKAGE_SWUPDATE_CONFIG to point at our own kconfig file
# with CURL=y, DOWNLOAD=y, SURICATTA=y, WEBSERVER=n. libcurl is required
# as a Buildroot dependency because the swupdate Config.in doesn't auto-
# select it.
BR2_PACKAGE_SWUPDATE=y
BR2_PACKAGE_SWUPDATE_CONFIG="$(BR2_EXTERNAL_WAYPOINT_PATH)/package/waypoint-overrides/swupdate.config"
BR2_PACKAGE_LIBCURL=y
# Without a TLS backend, libcurl is built with TLS_NONE and swupdate's
# channel_set_options() fails with CURLE_NOT_BUILT_IN — even for plain
# HTTP URLs, because some unconditional CURLOPT_* settings require an
# SSL provider to be linked in.
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_LIBCURL_OPENSSL=y
# Our sw-description.in is in libconfig syntax (the swupdate default).
# Without libconfig linked at runtime, only the json-c parser is
# available and parsing fails with "JSON File corrupted" — swupdate's
# generic error when JSON gets a libconfig stream.
BR2_PACKAGE_LIBCONFIG=y

# Post-build / post-image
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_WAYPOINT_PATH)/board/raspberrypi5/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_WAYPOINT_PATH)/board/raspberrypi5/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_WAYPOINT_PATH)/board/raspberrypi5/post-image.sh"

# GStreamer (for cameras). The v4l2 sub-plugin in gst1-plugins-good is
# OFF by default in Buildroot — without this explicit kconfig, the
# package builds but `v4l2src` (the element the agent's pi5 pipeline
# uses to capture from /dev/videoN) is absent. Pair with the kernel
# UVC fragment above; both are required for cameras to work end-to-end.
BR2_PACKAGE_GSTREAMER1=y
BR2_PACKAGE_GST1_PLUGINS_BASE=y
BR2_PACKAGE_GST1_PLUGINS_GOOD=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_V4L2=y
BR2_PACKAGE_GST1_PLUGINS_BAD=y
# Pi 5 has no hardware H.264 encoder, so cameras transcode in software:
# jpegdec (GST1_PLUGINS_GOOD_JPEG selects libjpeg) decodes MJPEG, x264enc
# (UGLY_PLUGIN_X264 selects libx264, GPL) re-encodes to H.264, and h264parse
# (videoparsers in gst-bad) frames the stream for WebRTC. NOTE the good-jpeg
# symbol is GST1_PLUGINS_GOOD_JPEG, not ..._PLUGIN_JPEG (unlike _PLUGIN_V4L2).
BR2_PACKAGE_GST1_PLUGINS_GOOD_JPEG=y
BR2_PACKAGE_GST1_PLUGINS_UGLY=y
BR2_PACKAGE_GST1_PLUGINS_UGLY_PLUGIN_X264=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_VIDEOPARSERS=y
# libv4l ships libv4lconvert (autoselected by gst v4l2src); LIBV4L_UTILS
# adds v4l2-ctl for introspecting cameras from the rover shell.
BR2_PACKAGE_LIBV4L=y
BR2_PACKAGE_LIBV4L_UTILS=y
