# Build artifacts
agent/web/dist/*
!agent/web/dist/.empty
# Compiled daemons (built by `go build`, never committed)
agent/waypoint-agent
proxy/waypoint-proxy
dashboard/dist/
# Vite dep-optimization cache (regenerated on every build/dev run)
**/.vite/
dashboard/node_modules/
**/node_modules/
**/__pycache__/
**/*.pyc

# Go
**/bin/
**/*.test
**/*.out
**/coverage.txt
# Vendored deps for Buildroot image builds. Auto-generated by
# image/Makefile's vendor-* targets (Buildroot pins GOFLAGS=-mod=vendor
# for every Go package and refuses network access at build time).
agent/vendor/
modules/*/vendor/

# Editor
.vscode/
.idea/
.DS_Store

# Local state
.superpowers/
.env
.env.local
agent/.local/
.claude/worktrees
# Internal planning docs and local agent skills, kept out of the public repo
docs/superpowers/
docs/visuals/
.claude/skills/
# Dev-image SSH keys are personal — each developer drops their own pubkey
# here; the build treats a missing file as "no SSH access baked in".
image/external/board/raspberrypi5/rootfs-overlay-dev/root/.ssh/authorized_keys

# Buildroot output + cache
image/output/
image/dl/
image/ccache/
image/scripts/broken-overlay/

# Generated bindings checked in; ignore tooling caches only
protocol/.cache/

# Clangd / IDE state (compile_commands.json is a symlink into core/build/)
/compile_commands.json

# firmware/servo-relay/
firmware/servo-relay/build/
firmware/servo-relay/sdkconfig
firmware/servo-relay/sdkconfig.old
firmware/servo-relay/managed_components/
firmware/servo-relay/dependencies.lock
firmware/servo-relay/test/test_counters
firmware/servo-relay/test/test_frame_observer

# Built basemap tilesets (uploaded to the proxy volume, never committed)
scripts/basemap/*.pmtiles

# Stray CMake build state (core builds live in core/build/)
CMakeFiles/
CMakeCache.txt
