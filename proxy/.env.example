# Required
PORT=8081
DATABASE_URL=postgres://waypoint:dev@localhost:5432/waypoint?sslmode=disable

# Operator NKey (base64-encoded seed; generate with: make proxy-init-operator)
OPERATOR_NKEY_SEED=
OPERATOR_PUBLIC_KEY=

# WorkOS
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=http://localhost:8081/auth/callback
WORKOS_COOKIE_PASSWORD=  # 32+ random bytes, base64

# Public origin of this proxy (used in /api/me + magic links)
PUBLIC_ORIGIN=http://localhost:8081
